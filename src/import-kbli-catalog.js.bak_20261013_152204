const fs = require("fs");
const path = require("path");
const mysql = require("mysql2/promise");

const csvPath = path.resolve(
  __dirname,
  "../../marketplace_web/public/data/kbli_2025.csv"
);

function parseCsv(text) {
  const rows = [];
  let row = [], field = "", quoted = false;

  for (let i = 0; i < text.length; i++) {
    const c = text[i];

    if (quoted) {
      if (c === '"' && text[i + 1] === '"') {
        field += '"';
        i++;
      } else if (c === '"') {
        quoted = false;
      } else {
        field += c;
      }
    } else if (c === '"' && field.length === 0) {
      quoted = true;
    } else if (c === ',') {
      row.push(field);
      field = "";
    } else if (c === '\n') {
      row.push(field);
      if (row.some(v => v.trim())) rows.push(row);
      row = [];
      field = "";
    } else if (c !== '\r') {
      field += c;
    }
  }

  if (quoted) throw new Error("Kutip CSV tidak berpasangan.");

  if (field.length || row.length) {
    row.push(field);
    if (row.some(v => v.trim())) rows.push(row);
  }

  return rows;
}

async function main() {
  if (!fs.existsSync(csvPath)) throw new Error("CSV tidak ditemukan.");

  const parsed = parseCsv(fs.readFileSync(csvPath, "utf8"));
  const headers = parsed.shift().map(
    v => v.trim().replace(/^\uFEFF/, "")
  );
  const idx = Object.fromEntries(headers.map((h, i) => [h, i]));

  for (const h of [
    "code", "title", "level", "parent_code", "CuplikanUraian"
  ]) {
    if (idx[h] === undefined) throw new Error(`Kolom hilang: ${h}`);
  }

  const rank = {
    group_pokok: 0, group: 1, subgroup: 2, activity: 3
  };
  const byCode = new Map();

  const rows = parsed.map((r, n) => {
    const get = h => String(r[idx[h]] ?? "").trim();
    const code = get("code");
    const title = get("title");
    const level = get("level");
    const csvParent = get("parent_code");

    if (!code || !title || rank[level] === undefined) {
      throw new Error(`Baris CSV ${n + 2} tidak valid.`);
    }
    if (byCode.has(code)) throw new Error(`Kode duplikat: ${code}`);

    const item = {
      code, title, level,
      parent_code: level === "group_pokok" ? null : csvParent,
      section_code: level === "group_pokok" ? csvParent : null,
      description: get("CuplikanUraian")
    };

    byCode.set(code, item);
    return item;
  });

  function sectionOf(item) {
    if (item.section_code) {
      if (!/^[A-V]$/.test(item.section_code)) {
        throw new Error(`Section tidak valid: ${item.code}`);
      }
      return item.section_code;
    }
    const parent = byCode.get(item.parent_code);
    if (!parent) {
      throw new Error(
        `Parent ${item.parent_code} tidak ditemukan untuk ${item.code}`
      );
    }
    if (rank[parent.level] !== rank[item.level] - 1) {
      throw new Error(`Level hierarki salah: ${item.code}`);
    }
    return sectionOf(parent);
  }

  for (const item of rows) item.section_code = sectionOf(item);

  rows.sort((a, b) =>
    rank[a.level] - rank[b.level] || a.code.localeCompare(b.code)
  );

  const counts = Object.fromEntries(
    Object.keys(rank).map(level => [
      level, rows.filter(r => r.level === level).length
    ])
  );

  console.log("CSV valid:", rows.length, "kode unik");
  console.log("Distribusi level:", counts);

  const db = await mysql.createConnection({
    host: "127.0.0.1",
    port: 3306,
    user: "root",
    password: "",
    database: "nusadhipa_marketplace",
    charset: "utf8mb4"
  });

  try {
    const [tables] = await db.execute(`
      SELECT COUNT(*) AS n
      FROM information_schema.tables
      WHERE table_schema = DATABASE()
        AND table_name = 'ref_kbli_codes'
    `);
    if (Number(tables[0].n) !== 1) {
      throw new Error("Tabel ref_kbli_codes tidak ditemukan.");
    }

    const [existing] = await db.execute(
      "SELECT COUNT(*) AS n FROM ref_kbli_codes"
    );
    if (Number(existing[0].n) !== 0) {
      throw new Error(
        `Katalog sudah berisi ${existing[0].n} baris; impor dibatalkan.`
      );
    }

    await db.beginTransaction();
    try {
      const sql = `
        INSERT INTO ref_kbli_codes
        (code, title, description, level, parent_code,
         section_code, source_file, source_version)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
      `;

      for (const r of rows) {
        await db.execute(sql, [
          r.code, r.title, r.description || null, r.level,
          r.parent_code, r.section_code, "kbli_2025.csv", "2025"
        ]);
      }

      const [check] = await db.execute(`
        SELECT COUNT(*) AS total,
               COUNT(DISTINCT code) AS unique_codes,
               SUM(parent_code IS NULL) AS roots
        FROM ref_kbli_codes
      `);

      if (
        Number(check[0].total) !== rows.length ||
        Number(check[0].unique_codes) !== rows.length
      ) {
        throw new Error("Jumlah hasil impor tidak cocok dengan CSV.");
      }

      await db.commit();
      console.log("IMPOR BERHASIL:", check[0]);
    } catch (e) {
      await db.rollback();
      throw e;
    }
  } finally {
    await db.end();
  }
}

main().catch(e => {
  console.error("IMPOR GAGAL:", e.message);
  process.exitCode = 1;
});
